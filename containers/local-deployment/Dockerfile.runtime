# Repackage the locally built application without compiler/source layers.
# Rebuild wetty.local first when application code changes.
FROM wetty.local AS application
FROM node:22-alpine
RUN apk add --no-cache coreutils openssh-client sshpass libstdc++
WORKDIR /usr/src/app
ENV NODE_ENV=production HOME=/home/node
COPY --from=application /usr/src/app/package.json ./package.json
COPY --from=application /usr/src/app/node_modules ./node_modules
COPY --from=application /usr/src/app/build ./build
USER 1000:1000
EXPOSE 3000
ENTRYPOINT ["node", "./build/main.js"]
